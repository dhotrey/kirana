CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
CLOUDFLARE_AI_GATEWAY_API_TOKEN=<your-cloudflare-ai-gateway-api-token>
# Optional: call Gemini via Google AI Studio OpenAI-compatible API and skip the gateway
# for OCR only (Mistral summarisation still uses the gateway). Get a key at:
# https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# GEMINI_OPENAI_MODEL_ID=gemini-3-flash-preview
KIRANA_DB_ID=<your-d1-database-id> # this is automatically generated by the setup script
AWS_ACCESS_KEY_ID=<your-tigris-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-tigris-secret-access-key>

# Pydantic Logfire write token. Auto-bootstrapped from ~/.logfire/default.toml
# on first run if unset.
LOGFIRE_TOKEN=<your-logfire-write-token>
# Set to 1 to skip Logfire (e.g. invalid token in ~/.logfire or no project).
KIRANA_DISABLE_LOGFIRE=0
# Prefer LOGFIRE_TOKEN from the environment over ~/.logfire/default.toml (e.g. CI).
LOGFIRE_PREFER_ENV=0

# Gemini is called via Cloudflare AI Gateway (OpenAI-compatible). The Google AI Studio
# API key is configured on the gateway provider in the Cloudflare dashboard, not here.