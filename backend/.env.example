CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
KIRANA_DB_ID=<your-d1-database-id> # this is automatically generated by the setup script

# Tigris storage credentials
AWS_ACCESS_KEY_ID=<your-tigris-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-tigris-secret-access-key>
AWS_ENDPOINT_URL_S3=<your-tigris-endpoint-url-s3>
AWS_ENDPOINT_URL_IAM=<your-tigris-endpoint-url-iam>
AWS_REGION=<your-tigris-region>